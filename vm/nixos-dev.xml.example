<!--
  Reference shape for the libvirt guest created by virt-manager.
  The actual UUID, MAC address, and disk serial are generated by libvirt.
  No hostdev/PCI device entries may be added to the real domain.
-->
<domain type='kvm'>
  <name>nixos-dev</name>
  <memory unit='MiB'>16384</memory>
  <vcpu placement='static'>12</vcpu>
  <os firmware='efi'>
    <type arch='x86_64' machine='q35'>hvm</type>
  </os>
  <features>
    <acpi/>
    <apic/>
  </features>
  <devices>
    <disk type='file' device='disk'>
      <driver name='qemu' type='qcow2'/>
      <source file='/mnt/SSD/VM_Storage/nixos-dev.qcow2'/>
      <target dev='vda' bus='virtio'/>
    </disk>
    <interface type='network'>
      <source network='default'/>
      <model type='virtio'/>
    </interface>
    <video>
      <model type='virtio' heads='1' primary='yes'/>
    </video>
    <graphics type='spice' autoport='yes'/>
  </devices>
</domain>
