{ config, lib, pkgs, ... }:

let
  cfg = config.myHome.hyprland;
  fragmentLines = map (fragment:
    "dofile(${builtins.toJSON (toString fragment)})") cfg.fragments;
  toggleFloatingLine =
    "hl.bind(${builtins.toJSON cfg.floatingToggleChord}, hl.dsp.exec_cmd(\"hyprctl dispatch togglefloating\"))";
  startupLines = map (command:
    "hl.on(\"hyprland.start\", function() hl.exec_cmd(${builtins.toJSON command}) end)")
    cfg.startupCommands;
  loader = lib.concatStringsSep "\n" ([
    "-- Generated by home/modules/hyprland.nix; do not edit."
  ] ++ fragmentLines ++ [ toggleFloatingLine ] ++ startupLines);
in {
  options.myHome.hyprland = {
    enable = lib.mkOption {
      type = lib.types.bool;
      default = false;
      description = "Enable Hyprland and its generated native loader.";
    };
    fragments = lib.mkOption {
      type = lib.types.listOf (lib.types.either lib.types.path lib.types.str);
      default = [];
      description = "Resolved Hyprland Lua fragments to load in order.";
    };
    floatingToggleChord = lib.mkOption {
      type = lib.types.str;
      default = "SUPER + V";
      description = "The single Hyprland chord that toggles floating windows.";
    };
    startupCommands = lib.mkOption {
      type = lib.types.listOf lib.types.str;
      default = [];
      description = "Commands to execute when Hyprland starts.";
    };
  };

  config = lib.mkIf cfg.enable {
    home.packages = [ pkgs.hyprland ];
    home.file.".config/hypr/hyprland.lua".text = loader;
  };
}
