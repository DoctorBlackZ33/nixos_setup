{ config, lib, pkgs, ... }:

let
  cfg = config.myHome.neovim;
  neovimRoot = ../config/nvim;
  neovimInit = neovimRoot + "/init.lua";
  lazyLock = neovimRoot + "/lazy-lock.json";
  featureImport = feature: [
    "  { import = \"plugins.${feature}\" },"
  ];
  profile = lib.concatStringsSep "\n" ([
    "-- Generated by home/modules/neovim.nix; do not edit."
    "return {"
  ] ++ lib.concatMap featureImport cfg.features ++ [ "}" ]);
  sharedConfigFiles = {
    "nvim/init.lua" = { source = neovimInit; };
    "nvim/lua" = { source = neovimRoot + "/lua"; recursive = true; };
    "nvim/colors" = { source = neovimRoot + "/colors"; recursive = true; };
    "nvim/stylua.toml" = { source = neovimRoot + "/stylua.toml"; };
    "nvim/lazyvim.json" = { source = neovimRoot + "/lazyvim.json"; };
    "nvim/neovim-profile.lua" = { text = profile; };
  };
in {
  options.myHome.neovim = {
    enable = lib.mkOption {
      type = lib.types.bool;
      default = false;
      description = "Enable Neovim and the shared LazyVim configuration.";
    };
    features = lib.mkOption {
      type = lib.types.listOf (lib.types.enum [ "core" "coding" "content" "workflow" ]);
      default = [];
      description = "Native Neovim feature groups to import.";
    };
    defaultEditor = lib.mkOption {
      type = lib.types.bool;
      default = true;
      description = "Set Neovim as the default editor.";
    };
    withNodeJs = lib.mkOption {
      type = lib.types.bool;
      default = true;
      description = "Enable Node.js integration in Neovim.";
    };
    extraPackages = lib.mkOption {
      type = lib.types.listOf lib.types.package;
      default = with pkgs; [
        alejandra
        bash-language-server
        lazygit
        lua-language-server
        markdown-toc
        markdownlint-cli2
        marksman
        nodejs
        nixd
        prettier
        shellcheck
        shfmt
        statix
        stylua
        taplo
        tree-sitter
        vscode-langservers-extracted
      ];
      description = "External tools made available to Neovim.";
    };
  };

  config = lib.mkIf cfg.enable {
    programs.neovim = {
      enable = true;
      defaultEditor = cfg.defaultEditor;
      withNodeJs = cfg.withNodeJs;
      extraPackages = cfg.extraPackages;
      initLua = builtins.readFile neovimInit;
    };

    xdg.configFile = sharedConfigFiles;

    home.activation.neovimLazyLock = lib.hm.dag.entryAfter [ "writeBoundary" ] ''
      install -Dm644 ${lazyLock} ${config.xdg.dataHome}/nvim/lazy-lock.json
    '';
  };
}
